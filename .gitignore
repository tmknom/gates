# 機密ファイルをここに足すときは、scripts/trivy/compose.yaml と scripts/tflint/compose.yaml でもコンテナから隠す。
# 隠すパスはそれぞれの compose.yaml に列挙していて、ここに足しても自動では隠れない

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Output of the build and the coverage tool
dist/

# Dependency directories (remove the comment below to include it)
# vendor/

# https://github.com/tmknom/makefiles
.makefiles/

# Tools for environment variables
.envrc
.env

# Editors
.idea/
.vscode/

# macOS
.DS_Store

# General
tmp/
*.log
