# 機密ファイルは、scripts/golangci-lint/compose.yaml と scripts/trivy/compose.yaml がコンテナから隠している tmp/ か terraform/local/ に置く。
# 隠すパスはそれぞれの compose.yaml に列挙していて、ここに足しても自動では隠れないため、ほかの場所に置くときは両方でも隠す

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Output of the build and the coverage tool
dist/

# Dependency directories (remove the comment below to include it)
# vendor/

# https://github.com/tmknom/makefiles
.makefiles/

# Tools for environment variables
.envrc
.env

# Editors
.idea/
.vscode/

# macOS
.DS_Store

# Terraform: 手元の値は terraform/local/ に置く
terraform/local/
# ほかの場所に誤って作ったときの備え
*.tfvars
*.tfstate
*.tfstate.*
*.tfplan
.terraform/

# General
tmp/
*.log
