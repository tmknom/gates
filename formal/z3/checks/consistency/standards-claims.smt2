; expect: sat sat
; trace:checks RFC7519-ISS-FORMAT RFC7519-ISS-OPTIONAL RFC7519-SUB-FORMAT RFC7519-SUB-OPTIONAL RFC7519-JTI-FORMAT RFC7519-JTI-OPTIONAL RFC7519-STRINGORURI-COMPARE RFC7519-STRING-COMPARE RFC7159-STRING-COMPARE RFC7519-CLAIM-UNKNOWN-IGNORE RFC8725-SUB-VALIDATE OIDCC-ISS-REQUIRED OIDCC-ISS-FORMAT OIDCC-SUB-REQUIRED OIDCC-SUB-LENGTH OIDCC-SUB-FORMAT OIDCC-AUD-REQUIRED OIDCC-AUD-CLIENT-ID OIDCC-AUD-FORMAT OIDCC-EXP-REQUIRED OIDCC-EXP-FORMAT OIDCC-EXP-LEEWAY OIDCC-EXP-REJECT OIDCC-IAT-REQUIRED OIDCC-IAT-FORMAT OIDCC-AUTH-TIME-REQUIRED OIDCC-NONCE-VERIFY OIDCC-NONCE-INCLUDE OIDCC-NONCE-FORMAT OIDCC-AZP-CLIENT-ID OIDCC-CLAIM-UNKNOWN-IGNORE OIDCC-CODE-ISS-MATCH OIDCC-CODE-AUD-CLIENT OIDCC-CODE-AUD-UNTRUSTED OIDCC-CODE-AZP-CLIENT-ID OIDCC-CODE-EXP OIDCC-CODE-NONCE OIDCC-IMPLICIT-NONCE OIDCC-STRING-CODE-POINT OIDCC-STRING-NO-NORMALIZATION
; The clauses on the other Claims do not contradict each other or the time
; and audience clauses: some Claims Set satisfies all of them as an ID Token of
; the Authorization Code Flow whose request sent a nonce and asked for
; auth_time, and some satisfies the RFC 7519 ones with every Claim omitted.
(declare-const anyClaims Claims)
(declare-const clock Int)
(declare-const leeway Real)
(declare-const clientId String)
(declare-const sentNonce String)
(declare-const issuer String)
(declare-const validSubject (Array String Bool))
(declare-const trusted (Array String Bool))
(define-fun rfc7519-claims ((c Claims)) Bool
  (and (std-iss-format c) (std-sub-format c) (std-jti-format c)
       (std-exp-numericdate c) (std-iat-numericdate c)
       (std-sub-validate c validSubject)))
(push 1)
(assert (rfc7519-claims anyClaims))
(assert (std-aud-identifies anyClaims clientId))
(assert (std-exp-reject anyClaims clock 0.0))
(assert (std-oidc-iss-required anyClaims true))
(assert (std-oidc-iss-format anyClaims true))
(assert (std-oidc-sub-required anyClaims true))
(assert (std-oidc-sub-length anyClaims true))
(assert (std-oidc-sub-format anyClaims true))
(assert (std-oidc-aud-required anyClaims true))
(assert (std-oidc-aud-client-id anyClaims true clientId))
(assert (std-oidc-aud-format anyClaims true))
(assert (std-oidc-exp-required anyClaims true))
(assert (std-oidc-exp-format anyClaims true))
(assert (std-oidc-exp-leeway leeway))
(assert (std-oidc-exp-reject anyClaims true true clock leeway))
(assert (std-oidc-iat-required anyClaims true))
(assert (std-oidc-iat-format anyClaims true))
(assert (std-oidc-auth-time-required anyClaims true true))
(assert (std-oidc-nonce-verify anyClaims true sentNonce))
(assert (std-oidc-nonce-include anyClaims true true sentNonce))
(assert (std-oidc-nonce-format anyClaims true))
(assert (std-oidc-azp-client-id anyClaims true clientId))
(assert (std-oidc-code-iss-match anyClaims true issuer))
(assert (std-oidc-code-aud-client anyClaims true clientId))
(assert (select trusted clientId))
(assert (std-oidc-code-aud-untrusted anyClaims true trusted))
(assert (std-oidc-code-azp-client-id anyClaims true clientId))
(assert (std-oidc-code-exp anyClaims true clock leeway))
(assert (std-oidc-code-nonce anyClaims true true sentNonce))
(assert (std-oidc-implicit-nonce anyClaims false sentNonce))
(assert (std-claim-unknown-ignore false false true true))
(assert (std-oidc-claim-unknown-ignore true false true true))
(assert (std-stringoruri-equal issuer issuer))
(assert (std-jwt-string-equal clientId clientId))
(assert (std-oidc-string-equal sentNonce sentNonce))
(assert (std-json-string-equal sentNonce sentNonce))
(check-sat)
(pop 1)
(push 1)
(assert (rfc7519-claims anyClaims))
(assert (std-iss-omitted anyClaims))
(assert (std-sub-omitted anyClaims))
(assert (std-jti-omitted anyClaims))
(check-sat)
(pop 1)
