; expect: sat sat sat sat sat sat sat
; trace:checks GH-OIDC-ISS GH-OIDC-CLAIMS-TOKEN-TABLE GH-OIDC-REGISTERED-CLAIMS GH-OIDC-REPOSITORY-ID GH-OIDC-REPOSITORY-OWNER-ID GH-OIDC-EVENT-NAME-DEPENDABOT GH-OIDC-REPO-PROPERTY-VALUE GH-OIDC-REPO-PROPERTY-PRESENCE GH-OIDC-AUD-DEFAULT GH-OIDC-AUD-CUSTOM GH-OIDC-SUB-IMMUTABLE-REASON GH-OIDC-SUB-IMMUTABLE-FORMAT GH-OIDC-SUB-AT-SEPARATOR GH-OIDC-SUB-CONTEXT GH-OIDC-SUB-IMMUTABLE-DEFAULT GH-OIDC-SUB-LEGACY-RETAINED GH-OIDC-SUB-RENAME-TRANSFER GH-OIDC-SUB-CUSTOM-REPLACE GH-OIDC-SUB-CUSTOM-IMMUTABLE-IDS GH-OIDC-DISCOVERY-ALG GH-OIDC-DISCOVERY-CLAIMS GH-OIDC-CLAIMS-UNDESCRIBED GH-OIDC-JWKS-KID-FORMAT GH-OIDC-HEADER-OBSERVED GH-OIDC-HEADER-KID-JWKS GH-OIDC-CLAIM-TYPE-OBSERVED GH-OIDC-CLAIM-PRESENCE-OBSERVED GH-OIDC-REPOSITORY-OWNER-ID-OBSERVED GH-OIDC-RUN-ATTEMPT-OBSERVED GH-OIDC-WORKFLOW-REF-OBSERVED GH-OIDC-TIME-OBSERVED GH-OIDC-AUD-DEFAULT-OBSERVED GH-OIDC-SUB-OBSERVED
; The GitHub clauses do not contradict each other. Some issuance satisfies
; every Documented clause for a repository with the legacy form, and some for
; one with the immutable form. Some issuance with a Header satisfies every
; Documented, Published and Observed clause, without an Audience requested.
; The last four are the issuances of checks/fixtures.smt2 with the premises
; the compatibility checks add, so the checks that expect unsat do not hold
; vacuously. The fixed names, IDs, contexts and kid only guide the search.
(declare-const anyClaims Claims)
(declare-const anyHeader Header)
(declare-const ownerUrl String)
(declare-const property String)
(define-fun documented ((c Claims)) Bool
  (and (gh-iss c) (gh-registered-claims c usedAt)
       (gh-repository-id c repositoryId) (gh-repository-owner-id c ownerId)
       (gh-event-name-dependabot c false)
       (gh-repo-property-value c property)
       (gh-repo-property-presence c property true true)
       (gh-aud-default c ownerUrl)
       (gh-name-without-at owner) (gh-name-without-at repo)
       (gh-sub-immutable-default createdAfter false form)
       (gh-sub-legacy-retained createdAfter optedIn renamed false form)
       (gh-sub-rename-transfer renamed false form)
       (gh-sub-custom-replace false form)
       (gh-sub-custom-immutable-ids c form true true owner ownerId repo repositoryId)
       (gh-sub-form c form owner ownerId repo repositoryId context)
       ((_ is Present) (select c "sub"))
       (str.prefixof "repo_property_" property)
       (gh-claims-token-table-name property)))
(push 1)
(assert (documented anyClaims))
(assert (= form LegacyForm))
(check-sat)
(pop 1)
(push 1)
(assert (documented anyClaims))
(assert (= form ImmutableForm))
(check-sat)
(pop 1)
(push 1)
(assert (documented anyClaims))
(assert (= form ImmutableForm))
(assert (= kid "38826b17-6a30-5f9b-b169-8beb8202f723"))
(assert (= owner "octocat"))
(assert (= ownerId "583231"))
(assert (= repo "example-repo"))
(assert (= repositoryId "1234567890"))
(assert (= context "pull_request"))
(assert (gh-discovery-alg anyHeader))
(assert (gh-header-observed anyHeader (JString kid) typ x5t))
(assert (gh-header-kid-jwks anyHeader kid))
(assert (gh-jwks-kid-format kid))
(assert (gh-claim-type-observed anyClaims "exp"))
(assert (gh-claim-type-observed anyClaims "repository_id"))
(assert (gh-claim-type-observed anyClaims "sub"))
(assert (gh-claim-presence-observed anyClaims false false))
(assert (gh-repository-owner-id-observed anyClaims))
(assert (gh-run-attempt-observed anyClaims))
(assert (gh-workflow-ref-observed anyClaims false))
(assert (gh-time-observed anyClaims))
(assert (gh-aud-default-observed anyClaims ownerUrl))
(assert (gh-sub-observed anyClaims owner ownerId repo repositoryId context))
(assert (gh-claims-undescribed-name "sha"))
(assert (gh-discovery-claims-name "sub"))
(check-sat)
(pop 1)
(push 1)
(assert documented-issuance)
(assert clocks-in-range)
(assert clock-skew-within-leeway)
(check-sat)
(pop 1)
(push 1)
(assert documented-issuance)
(assert immutable-repository)
(assert documented-names)
(assert (= context "ref:refs/heads/main"))
(check-sat)
(pop 1)
(push 1)
(assert observed-issuance)
(assert clocks-in-range)
(assert clock-skew-within-leeway)
(assert (= kid "38826b17-6a30-5f9b-b169-8beb8202f723"))
(check-sat)
(pop 1)
(push 1)
(assert observed-issuance)
(assert observed-names)
(assert (= context "environment:testing"))
(assert (= kid "38826b17-6a30-5f9b-b169-8beb8202f723"))
(check-sat)
(pop 1)
