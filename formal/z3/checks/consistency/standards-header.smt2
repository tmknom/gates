; expect: sat sat sat
; trace:checks RFC7515-HEADER-DEFINED-UNKNOWN-IGNORE RFC7515-HEADER-EXTENSION-UNKNOWN-IGNORE RFC7515-ALG-REQUIRED RFC7515-ALG-UNDERSTAND RFC7515-ALG-FORMAT RFC7515-ALG-APPLICATION-ACCEPTABLE RFC7515-KEY-IDENTIFY RFC7515-JKU-OPTIONAL RFC7515-JWK-OPTIONAL RFC7515-X5U-OPTIONAL RFC7515-X5C-OPTIONAL RFC7515-X5T-OPTIONAL RFC7515-X5T-S256-OPTIONAL RFC7515-KID-FORMAT RFC7515-KID-OPTIONAL RFC7515-TYP-OPTIONAL RFC7515-CTY-OPTIONAL RFC7515-TYP-PREFIX-OMIT RFC7515-CTY-PREFIX-OMIT RFC7515-TYP-PREFIX-RESTORE RFC7515-CTY-PREFIX-RESTORE RFC7515-CRIT-UNDERSTAND RFC7515-CRIT-UNSUPPORTED-INVALID RFC7515-CRIT-FORMAT RFC7515-CRIT-REGISTERED-NAME RFC7515-CRIT-DUPLICATE RFC7515-CRIT-ABSENT-NAME RFC7515-CRIT-EMPTY RFC7515-CRIT-VIOLATION-INVALID RFC7515-CRIT-OPTIONAL RFC7515-STRING-COMPARE RFC7518-NONE-CREATE RFC7518-NONE-ACCEPT-SPECIFIED RFC7518-NONE-ACCEPT-DEFAULT RFC7518-NONE-GLOBAL RFC7518-NONE-PER-OBJECT RFC7519-TYP-VALUE RFC7519-TYP-UPPERCASE RFC7519-TYP-OPTIONAL RFC7519-CTY-NOT-NESTED RFC7519-CTY-NESTED-PRESENT RFC7519-CTY-NESTED-VALUE RFC7519-CTY-UPPERCASE RFC7519-UNSECURED-CREATE RFC7519-ALG-ACCEPTABLE RFC7797-B64-FORMAT RFC7797-B64-OPTIONAL RFC7797-CRIT-B64 RFC7797-B64-TRUE-OMIT RFC7797-JWT-B64-FALSE RFC8725-ALG-SET-SPECIFY RFC8725-ALG-SET-RESTRICT RFC8725-ALG-CURRENT RFC8725-ALG-NONE-GENERATE RFC8725-ALG-NONE-CONSUME RFC8725-JKU-X5U-SSRF RFC8725-KIND-CONFUSION-MITIGATE RFC8725-KIND-EXCLUSIVE RFC8725-TYP-PREFIX-OMIT RFC8725-TYP-MEDIA-TYPE OIDCC-ALG-NONE OIDCC-KEY-HEADER-AVOID OIDCC-CODE-ALG-DEFAULT
; The JOSE Header clauses do not contradict each other: some Header of a
; signed, non-nested JWT satisfies all of them; some Header with b64 true does,
; which needs crit and is the only b64 a JWT may carry; and an Unsecured JWT
; without typ exists, which the none clauses then
; let a recipient refuse.
(declare-const anyHeader Header)
(declare-const algorithms (Array String Bool))
(declare-const extensions (Array String Bool))
(declare-const mediaType String)
(define-fun standards-header ((h Header)) Bool
  (and (std-jws-alg-present h) (std-jws-alg-understood h algorithms)
       (std-jws-alg-format h) (std-jws-alg-application-acceptable h algorithms)
       (std-jwt-alg-acceptable h algorithms) (std-alg-set-restrict h algorithms)
       (std-alg-current h algorithms)
       (std-jws-key-identify h false) (std-jws-kid-format h)
       (std-jws-typ-prefix-omitted h) (std-jws-cty-prefix-omitted h)
       (std-jws-typ-prefix-restore h true mediaType)
       (std-jws-cty-prefix-restore h true mediaType)
       (std-jws-crit-understood h extensions) (std-jws-crit-format h)
       (std-jws-crit-registered-name h) (std-jws-crit-duplicate h)
       (std-jws-crit-absent-name h) (std-jws-crit-empty h)
       (std-jws-crit-violation-invalid h false)
       (std-none-accept-default h false) (std-none-global false)
       (std-none-accept-specified h true false) (std-none-per-object h false)
       (std-jwt-typ-value h) (std-jwt-cty-not-nested h false)
       (std-jwt-cty-nested-present h false) (std-jwt-cty-nested-value h false)
       (std-b64-format h) (std-b64-crit h)
       (std-jwt-b64-not-false h)
       (std-alg-none-generate h false) (std-alg-none-consume h false)
       (std-typ-prefix-omitted h) (std-typ-media-type h false)
       (std-oidc-alg-none h true false) (std-oidc-key-header-avoid h true)
       (std-oidc-code-alg-default h true (string-member-value h "alg"))))
(push 1)
(assert (standards-header anyHeader))
(assert (std-jws-jku-omitted anyHeader)) (assert (std-jws-jwk-omitted anyHeader))
(assert (std-jws-x5u-omitted anyHeader)) (assert (std-jws-x5c-omitted anyHeader))
(assert (std-jws-x5t-omitted anyHeader)) (assert (std-jws-x5t-s256-omitted anyHeader))
(assert (not (std-jws-kid-omitted anyHeader)))
(assert (not (std-jwt-typ-omitted anyHeader)))
(assert (std-b64-true-omit anyHeader))
(assert (std-jws-cty-omitted anyHeader))
(assert (std-jws-crit-omitted anyHeader))
(assert (std-b64-omitted anyHeader))
(assert (std-jws-defined-unknown-ignore "typ" false true true))
(assert (std-jws-extension-unknown-ignore "nonce" false false true true))
(assert (std-jku-x5u-ssrf true true))
(assert (std-kind-confusion-mitigate true true false))
(assert (std-kind-exclusive true true false))
(assert (std-jws-string-equal mediaType mediaType))
(check-sat)
(pop 1)
(push 1)
(assert (standards-header anyHeader))
(assert (= (get-member anyHeader "b64") (Present (JBoolean true))))
(assert (= (get-member anyHeader "crit") (Present (JStringArray (seq.unit "b64")))))
(assert (std-jwt-typ-omitted anyHeader))
(check-sat)
(pop 1)
(push 1)
(assert (std-jwt-unsecured anyHeader))
(assert (std-none-create anyHeader))
(assert (std-none-per-object anyHeader true))
(assert (std-none-accept-specified anyHeader true true))
(assert (std-jws-typ-omitted anyHeader))
(assert (std-jws-alg-present anyHeader))
(assert (std-jws-alg-format anyHeader))
(check-sat)
(pop 1)
