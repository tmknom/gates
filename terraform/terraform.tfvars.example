# terraform/local/terraform.tfvars にコピーして値を設定する

region = "ap-northeast-1"

allowed_owner_id     = "12345678"
allowed_owner_name   = "example-owner"
allowed_owner_type   = "Organization"
github_app_client_id = "Iv23example"
gates_audience       = "https://github.com/example-owner/example-repo"

# 値の決め方は docs/contributing/setup-environment.md の kms_key_spec を参照する。RSA_2048、RSA_3072、RSA_4096 のいずれか
# kms_key_spec = ""

# log_retention_in_days       = 7
# lambda_reserved_concurrency = -1
