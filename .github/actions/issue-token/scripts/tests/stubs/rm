#!/usr/bin/env bash
# 試験用の rm。RM_STUB_FAIL のパターンに合う引数があれば、何も消さずに失敗する。
# ほかは本物の rm に渡す。ファイルを消せないときのスクリプトの振る舞いを確かめるために使う
#
# 環境変数
#   RM_STUB_FAIL  削除を失敗させるパスのパターン。空なら常に本物の rm に渡す
#   REAL_RM       本物の rm のパス
set -euo pipefail

if [[ -n "${RM_STUB_FAIL:-}" ]]; then
  for argument in "$@"; do
    # shellcheck disable=SC2053 # RM_STUB_FAIL をパターンとして比べる
    if [[ "${argument}" == ${RM_STUB_FAIL} ]]; then
      echo "rm: cannot remove '${argument}': Operation not permitted" >&2
      exit 1
    fi
  done
fi
exec "${REAL_RM}" "$@"
